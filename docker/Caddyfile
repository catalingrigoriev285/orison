# Orison inside the container: plain HTTP on :8080. TLS is terminated by
# whatever sits in front (nginx, Traefik, a load balancer...).
{
	admin off
	auto_https off
	frankenphp
	servers {
		# HTTP/2 and HTTP/3 need TLS, which the proxy in front terminates.
		protocols h1
	}
}

:{$ORISON_PORT:8080} {
	root * /app/public
	encode zstd br gzip

	# Vite output has content hashes in its file names.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	php_server
}
